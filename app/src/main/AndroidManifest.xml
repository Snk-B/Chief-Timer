<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exact alarms re-render the widget at countdown edges (day rollovers, finish times, boost
         edges). USE_EXACT_ALARM is granted at install on Android 13+; older versions use
         SCHEDULE_EXACT_ALARM. Without either, a 1-minute window alarm is used instead. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- "Builder free" notifications, Android 16+ Live Updates / Samsung Now Bar, and reboot alarm restore. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Online updates (app releases from SnK-B/Chief-Timer, ClashKing game data & icons, live Clash events), with offline cache fallback. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Optional in-game Clash Companion (Settings > Import assistant): overlay button + automatic game detection without Accessibility. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lets a notification tap open Clash of Clans (package visibility, Android 11+). -->
    <queries>
        <package android:name="com.supercell.clashofclans" />
    </queries>

    <application
        android:name=".ChiefApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChiefTimer">
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ChiefTimer"
            android:windowSoftInputMode="adjustResize" />

        <!-- Launcher entries (sync/AppIcon.kt); exactly one is enabled. "Themed" (the default) has the monochrome
             layer, so the phone's themed-icons setting decides. "Colour" never gets tinted. Developer options
             switches between them. -->
        <activity-alias
            android:name=".IconThemed"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconColour"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_colour"
            android:roundIcon="@mipmap/ic_launcher_colour_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- R8 on/off for this build (app/build.gradle.kts), shown in crash reports. -->
        <meta-data
            android:name="com.snkb.chieftimer.R8"
            android:value="${r8}" />

        <!-- Crash screen (crash/CrashReporter.kt): own process, so it opens even when the main
             process is the one that died; own task, so "Close" doesn't return to a broken screen. -->
        <activity
            android:name=".crash.CrashActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="Chief Timer crash"
            android:process=":crash"
            android:taskAffinity="com.snkb.chieftimer.crash"
            android:theme="@style/Theme.ChiefTimer" />

        <!-- Launched by the widget's Sync button: reads the clipboard once focused, then finishes. -->
        <activity
            android:name=".sync.SyncActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ChiefTimer.Invisible" />

        <!-- Optional Clash Companion (companion/CompanionService.kt): floating import button while Clash of Clans is open (no Accessibility). -->
        <service
            android:name=".companion.CompanionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Detects when Clash of Clans is in the foreground via UsageStats and displays an optional floating button to import village export JSON." />
        </service>

        <!-- Quick Settings tile to toggle the floating Clash Companion button on demand (works even without Usage Access). -->
        <service
            android:name=".companion.CompanionTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_timer"
            android:label="@string/companion_service_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Widget configuration activity for choosing an account -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.ChiefTimer">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Road to max widget (widget/RoadWidget.kt) and its configuration screen. -->
        <receiver
            android:name=".widget.RoadWidgetReceiver"
            android:exported="true"
            android:label="@string/road_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/road_widget_info" />
        </receiver>
        <activity
            android:name=".widget.RoadWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.ChiefTimer">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Alerts for the Clash tab's events (notify/EventAlerts.kt). -->
        <receiver
            android:name=".notify.EventAlertReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Background check for a new app release (update/UpdateCheckJob.kt). -->
        <service
            android:name=".update.UpdateCheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".widget.WidgetListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".notify.LiveCountdownService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Displays real-time live upgrade countdown chip in the status bar and lock screen during the final minutes before an upgrade completes." />
        </service>

        <receiver
            android:name=".widget.WidgetInternalReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.ChiefWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <!-- Alarms are cleared by a reboot and depend on the clock: reschedule on these. -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/chief_widget_info" />
        </receiver>
    </application>

</manifest>
