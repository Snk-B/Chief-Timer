<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="#0D1016" />
            <stroke android:width="1dp" android:color="@android:color/system_accent2_400" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="4dp" />
                <gradient android:angle="270" android:startColor="@android:color/system_accent3_200" android:endColor="@android:color/system_accent3_500" />
            </shape>
        </scale>
    </item>
</layer-list>
