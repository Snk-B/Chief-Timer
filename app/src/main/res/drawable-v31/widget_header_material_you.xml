<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <padding android:left="8dp" android:top="5.5dp" android:right="8dp" android:bottom="7dp" />
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
            <gradient android:angle="270" android:startColor="@android:color/system_neutral2_800" android:endColor="@android:color/system_neutral2_900" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@android:color/system_accent1_200" android:endColor="@android:color/system_accent1_500" />
        </shape>
    </item>
</layer-list>
