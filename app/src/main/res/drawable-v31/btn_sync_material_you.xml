<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="9dp" />
            <solid android:color="@android:color/system_accent1_900" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@android:color/system_accent1_800" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <gradient android:angle="270" android:startColor="@android:color/system_accent1_400" android:endColor="@android:color/system_accent1_600" />
        </shape>
    </item>
    <item android:left="3dp" android:top="2dp" android:right="3dp" android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#48FFFFFF" />
        </shape>
    </item>
</layer-list>
