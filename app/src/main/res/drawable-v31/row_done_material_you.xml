<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/system_neutral2_900" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:left="1.1dp" android:top="1.1dp" android:right="1.1dp" android:bottom="1.1dp">
        <nine-patch android:src="@drawable/row_stone_overlay_9p" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.1dp" android:color="@android:color/system_accent2_600" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
