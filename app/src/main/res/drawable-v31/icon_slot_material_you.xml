<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="@android:color/system_accent1_900" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient android:angle="270" android:startColor="@android:color/system_accent1_100" android:centerColor="@android:color/system_accent1_300" android:endColor="@android:color/system_accent1_600" />
        </shape>
    </item>
    <item android:left="2.5dp" android:top="2.5dp" android:right="2.5dp" android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="4.5dp" />
            <gradient android:angle="270" android:startColor="@android:color/system_neutral2_800" android:endColor="@android:color/system_neutral2_900" />
        </shape>
    </item>
</layer-list>
