<?xml version="1.0" encoding="utf-8"?>
<!-- Circular Beveled Golden Medallion for Assigned Apprentice / Lab Assistant -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A0E03" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FFE891"
                android:endColor="#946012" />
        </shape>
    </item>
    <item android:left="2.5dp" android:top="2.5dp" android:right="2.5dp" android:bottom="2.5dp">
        <shape android:shape="oval">
            <solid android:color="#3B260E" />
        </shape>
    </item>
</layer-list>
