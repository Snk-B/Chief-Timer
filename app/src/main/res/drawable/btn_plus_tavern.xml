<?xml version="1.0" encoding="utf-8"?>
<!-- Circular 3D Glossy Green [+] Helper Button -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#0B2608" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="#155E0E" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="2.5dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#74EF44"
                android:endColor="#289C1A" />
        </shape>
    </item>
</layer-list>
