<?xml version="1.0" encoding="utf-8"?>
<!-- Taverna Clash outer widget container: dark outline -> beveled metallic gold frame -> carved dark stone body -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#120A04" />
        </shape>
    </item>
    <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="16.5dp" />
            <gradient
                android:angle="270"
                android:startColor="#FFE694"
                android:centerColor="#D49B35"
                android:endColor="#7D5212" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#110D0A" />
        </shape>
    </item>
    <item android:left="5.5dp" android:top="5.5dp" android:right="5.5dp" android:bottom="5.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="12.5dp" />
            <gradient
                android:angle="270"
                android:startColor="#24201B"
                android:centerColor="#1C1915"
                android:endColor="#161310" />
        </shape>
    </item>
</layer-list>
