<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:forceDarkAllowed="false"
    android:paddingBottom="3dp"
    tools:targetApi="29">

    <LinearLayout
        android:id="@+id/row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/row_slot_tavern"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp">

        <FrameLayout
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/icon_slot_tavern">

            <ImageView
                android:id="@+id/ov_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="2dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ov_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/lilita_one"
                android:includeFontPadding="false"
                android:shadowColor="#E6000000"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="11.5dp" />

            <TextView
                android:id="@+id/ov_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#E6D8C3"
                android:textSize="9.5dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ov_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/lilita_one"
            android:includeFontPadding="false"
            android:shadowColor="#E6000000"
            android:shadowDy="1.5"
            android:shadowRadius="2"
            android:singleLine="true"
            android:textColor="#FFD863"
            android:textSize="12dp" />
    </LinearLayout>
</FrameLayout>
