<?xml version="1.0" encoding="utf-8"?>
<!-- Taverna Clash Road to Max Widget: 9-patch golden frame + curved 9-patch wood/obsidian header -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:forceDarkAllowed="false"
    android:padding="4dp"
    tools:targetApi="29">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_panel_tavern_9p"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_header_tavern"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/who_th_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/who"
                style="@style/WidgetText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/lilita_one"
                android:shadowColor="#E6000000"
                android:shadowDy="2"
                android:shadowRadius="2.5"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="14.5dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="@font/lilita_one"
            android:gravity="center"
            android:padding="10dp"
            android:shadowColor="#E6000000"
            android:shadowDy="1.5"
            android:shadowRadius="2"
            android:textColor="#FFFFFF"
            android:textSize="13.5dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:id="@+id/col_time"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/col_res"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
