<?xml version="1.0" encoding="utf-8"?>
<!-- Taverna Clash Grid Mode Plaque Tile: outer FrameLayout holds 9-patch background so setBackgroundResource never overwrites inner padding -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tile"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_margin="2.5dp"
    android:layout_weight="1"
    android:padding="0dp"
    android:forceDarkAllowed="false"
    android:background="@drawable/row_slot_tavern"
    tools:targetApi="29">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="7.5dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8.5dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">

            <!-- Kept gone: ring + icon + % are rendered sharply onto @+id/tile_icon via Canvas -->
            <ProgressBar
                android:id="@+id/tile_ring"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminate="false"
                android:indeterminateOnly="false"
                android:max="1000"
                android:progress="0"
                android:visibility="gone"
                android:progressDrawable="@drawable/tile_ring" />

            <TextView
                android:id="@+id/tile_initials"
                style="@style/WidgetSmallSans"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:textColor="#FFE082"
                android:textSize="11dp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/tile_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />

            <!-- Goblin Builder badge -->
            <ImageView
                android:id="@+id/tile_goblin"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="1dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <!-- [+] glossy green button or golden Apprentice / Assistant portrait badge in top-right corner so it never overlaps the % pill -->
            <FrameLayout
                android:id="@+id/tile_btn"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="top|end"
                android:background="@drawable/btn_plus_tavern"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tile_btn_text"
                    style="@style/WidgetSmallSans"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/lilita_one"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:shadowColor="#CC000000"
                    android:shadowDy="1"
                    android:shadowRadius="1.5"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="12dp" />

                <ImageView
                    android:id="@+id/tile_btn_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="1.5dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tile_name"
            style="@style/WidgetText"
            android:fontFamily="@font/lilita_one"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:shadowColor="#E6000000"
            android:shadowDy="1"
            android:shadowRadius="1.8"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="10.5dp" />

        <TextView
            android:id="@+id/tile_level"
            style="@style/WidgetText.Level"
            android:fontFamily="@font/lilita_one"
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0.5dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="#FFD55A"
            android:textSize="9.5dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="9.5dp"
                android:layout_height="9.5dp"
                android:layout_marginEnd="2dp"
                android:src="@drawable/ic_clock" />

            <Chronometer
                android:id="@+id/tile_chrono"
                style="@style/WidgetText.Time"
                android:fontFamily="@font/lilita_one"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:countDown="true"
                android:shadowColor="#E6000000"
                android:shadowDy="1"
                android:shadowRadius="1.8"
                android:textColor="#FFE082"
                android:textSize="10.5dp" />

            <TextView
                android:id="@+id/tile_text"
                style="@style/WidgetText.Time"
                android:fontFamily="@font/lilita_one"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFE082"
                android:textSize="10.5dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
